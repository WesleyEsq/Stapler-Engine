# scripts/bus_stop_intro.dlg
# Opening VN prologue: full-screen bus stop CG + Chloe detailed SVG portrait showcase
@cg chloe_bus_stop fade
@box default

say _ bus_stop_narration_01
say _ bus_stop_narration_02

@box thought
@portrait left chloe sleepy
say chloe bus_stop_chloe_01

@portrait left chloe nervous
say chloe bus_stop_chloe_02

@portrait left chloe soft_smile
say chloe bus_stop_chloe_03

@transition main_studio spawn_start
@end
